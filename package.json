{
  "name": "restart-career-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
  "backend:dev": "npm --prefix backend run dev",
  "backend:start": "npm --prefix backend run start",
  "frontend:dev": "npm --prefix frontend run dev",
  "frontend:build": "npm --prefix frontend run build",
  "frontend:lint": "npm --prefix frontend run lint",

  "start": "concurrently \"npm run backend:dev\" \"npm run frontend:dev\""
},
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "description": "RESTART is a web-based platform that helps former inmates rebuild their career pathway through structured learning, career preparation, and job opportunities that match their skills and interests.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Restar-ai/Restart.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Restar-ai/Restart/issues"
  },
  "homepage": "https://github.com/Restar-ai/Restart#readme"
}
